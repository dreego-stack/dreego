# smd.toml — example configuration
# See 'smd --toml' for the full reference. Remove or adapt what you need.

[project]
  name = "my-project"

[container]
  workdir = "/app"
  # runtime = "docker"

[security]
  allow_env = [".env.local"]

# [volume]
#   enabled = true
#   [volume.packages]
#     npm = true
#   mounts = ["my-vol:/data"]

# [port]
#   publish = ["8080:8080"]

# [session]
#   ports = ["8080:8080"]

# [live]
#   mount_pwd = true
#   ports = ["8080:8080"]

# [temp]
#   allow_env = []
#   mount_pwd = true
#   read_only = false

# Container recipe: install runtimes into the project image.
# smd builds 'smd-<project>' and only rebuilds when these lines change.
[dockerfile]
  lines = [
    "FROM docker.io/debian:bookworm-slim",
    "RUN apt-get update && apt-get install -y curl",
  ]
