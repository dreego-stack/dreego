
func renderIndex(c *dreego.SSRContext) (string, error) {
	var b strings.Builder

b.WriteString(`<title>Home</title>`)
	b.WriteString("<div data-scope=\"ce046becec8d\">")
	b.WriteString(`
    `)
	b.WriteString(`<h1>`)
	b.WriteString(`Welcome`)
	b.WriteString(`</h1>`)
	b.WriteString(`
    `)
	b.WriteString(`<p>`)
	b.WriteString(`Hello, `)
	b.WriteString(dreego.SafeText(fmt.Sprintf("%v", name)))
	b.WriteString(`!`)
	b.WriteString(`</p>`)
	b.WriteString(`
`)
	b.WriteString("</div>")

	return b.String(), nil
}

func HandleIndex(w http.ResponseWriter, r *http.Request) {
	c := dreego.NewSSR(w, r)
	html, err := renderIndex(c)
	if err != nil {
		http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte(html))
}
