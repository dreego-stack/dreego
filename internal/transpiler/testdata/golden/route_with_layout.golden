
func renderAbout(c dreego.RenderContext) (string, error) {
	var b strings.Builder

	b.WriteString("<div data-scope=\"949c712a1bb5\">")
	b.WriteString(`<h1>`)
	b.WriteString(`About us`)
	b.WriteString(`</h1>`)
	b.WriteString("</div>")
	pageContent := b.String()
	b.Reset()
b.WriteString(`<title>About</title>`)
	pageHead := b.String()
	b.Reset()
	b.WriteString(pageHead)
	head := b.String()
	b.Reset()
	c.Set("slot", pageContent)
	html, err := layouts.Default(c, pageContent, head)
	if err != nil { return "", err }
	b.WriteString(html)

	return b.String(), nil
}

func PageAbout() dreego.Component {
	return dreego.ComponentFunc(func(c dreego.RenderContext) (dreego.Result, error) {
		html, err := renderAbout(c)
		if err != nil { return dreego.Result{}, err }
		return dreego.Result{HTML: []byte(html)}, nil
	})
}

func HandleAbout(w http.ResponseWriter, r *http.Request) {
	c := dreego.NewSSR(w, r)
	html, err := renderAbout(c)
	if err != nil {
		http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte(html))
}
