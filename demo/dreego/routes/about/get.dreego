<head>
    <meta name="description" content="About Dreego">
</head>

<go>
    name := "Dreego"
    features := []string{"SSR-First", "File-based Routing", "Single Binary", "Layout System", "5 Sections"}
    version := "0.0.1"
</go>

<div>
    <h1>About {name}</h1>
    <p>Version: {version}</p>

    <h2>Features</h2>
    <ul>
        {#each features as feature}
            <li>{feature}</li>
        {/each}
    </ul>

    <a href="/">Back</a>
</div>

<script>
    console.log("about page loaded");
</script>

<style>
    h1 { color: #333; }
    h2 { color: #666; margin-top: 2rem; }
    li { margin: 0.5rem 0; }
</style>
