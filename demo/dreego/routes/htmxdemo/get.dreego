<head>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <title>HTMX Demo</title>
</head>

<go>
    count := 0
</go>

<div>
    <h1>HTMX Demo</h1>
    <p>Klicks: <span id="count">{count}</span></p>
    <button hx-post="/htmxdemo" hx-target="#result">
        Klick mich
    </button>
    <div id="result"></div>
    <a href="/">Zurück</a>
</div>

<style>
    button { padding: 0.5rem 1rem; cursor: pointer; margin: 1rem 0; }
    #result { margin-top: 1rem; }
</style>
