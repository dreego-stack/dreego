<head>
    <title>Dreego</title>
</head>

<go>
    message := "Hello from Dreego!"
</go>

<div>
    <h1>{message}</h1>
    <@Card title="Components with Scoped CSS"/>
    <p>Above: a <code>&lt;@Card&gt;</code> component with its own styles.</p>
    <a href="/about">About</a>
</div>

<style>
    body { font-family: system-ui; max-width: 800px; margin: 2rem auto; }
    h1 { color: #333; }
    a { color: #06f; }
</style>
