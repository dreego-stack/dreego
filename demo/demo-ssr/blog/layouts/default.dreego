<body>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    {#head}
</head>
<body>
    <a href="#main" class="skip-link">skip to content</a>
    <header class="border-b border-slate-200 bg-[#f7f7f3]">
        <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5" aria-label="Main navigation">
            <a href="/blog/" class="font-mono text-sm font-bold tracking-tight">dreego / blog</a>
            <div class="flex items-center gap-5 text-sm text-slate-600">
                <a href="/blog/" class="hover:text-slate-950">Posts</a>
                <a href="/blog/news" class="hover:text-slate-950">News</a>
                <a href="https://github.com/dreego-stack/dreego" class="rounded-full bg-slate-950 px-4 py-2 font-medium text-white hover:bg-slate-700">Source</a>
            </div>
        </nav>
    </header>
    <main id="main">
        <div class="prose">
        {#slot}
        </div>
    </main>
    <footer class="border-t border-slate-200"><div class="mx-auto flex max-w-4xl flex-wrap justify-between gap-4 px-6 py-8 text-sm text-slate-500"><span class="font-mono">dreego / blog</span><span>Written in Markdown.</span></div></footer>
</body>
</html>
</body>

<style>
.skip-link { position: absolute; left: -9999px; }
.skip-link:focus { position: fixed; top: 0.5rem; left: 0.5rem; z-index: 100; padding: 0.5rem 1rem; background: #000; color: #fff; border-radius: 0.25rem; }
.prose { max-width: 48rem; margin: 0 auto; padding: 3rem 1.5rem; line-height: 1.75; color: #334155; }
.prose .prose { padding: 0; }
.prose h1 { font-size: 2.25rem; font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; color: #0f172a; margin: 0 0 1.5rem; }
.prose h2 { font-size: 1.5rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; color: #0f172a; margin: 2.5rem 0 1rem; }
.prose h3 { font-size: 1.25rem; font-weight: 600; line-height: 1.3; color: #0f172a; margin: 2rem 0 0.75rem; }
.prose p { margin: 0 0 1.25rem; line-height: 1.75; }
.prose ul, .prose ol { padding-left: 1.5rem; margin: 0 0 1.25rem; }
.prose ul { list-style: disc; }
.prose ol { list-style: decimal; }
.prose li { margin: 0 0 0.5rem; }
.prose a { color: #0f766e; text-decoration: underline; text-underline-offset: 2px; }
.prose a.inline-flex { text-decoration: none; }
.prose blockquote { border-left: 4px solid #cbd5e1; padding-left: 1rem; margin: 0 0 1.25rem; color: #64748b; font-style: italic; }
.prose pre { background: #0f172a; color: #e2e8f0; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin: 0 0 1.25rem; }
.prose code { font-family: ui-monospace, monospace; font-size: 0.875em; color: #0f766e; }
.prose pre code { background: none; padding: 0; color: #e2e8f0; }
.prose .cards { max-width: none; }
.prose .cards a { color: inherit; text-decoration: none; }
.prose .cards h3 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; color: #0f172a; line-height: 1.2; margin: 1.5rem 0 0; }
.prose .cards p { margin: 0.75rem 0 0; color: #475569; line-height: 1.75; }
</style>
