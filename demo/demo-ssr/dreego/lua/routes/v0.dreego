<head>
    <title>JavaScript Baseline · Dreego</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A JavaScript baseline for the Dreego browser Lua showcase.">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="min-h-screen bg-slate-950 text-slate-100">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6" aria-label="Language comparison navigation">
            <a href="/lua/" class="font-mono text-lg font-bold text-cyan-300">← Lua version</a>
            <span class="rounded-full border border-slate-700 px-4 py-2 text-sm font-medium">JavaScript baseline</span>
        </nav>

        <main class="mx-auto max-w-6xl px-6 pb-20 pt-10">
            <section class="grid items-center gap-12 lg:grid-cols-2">
                <div>
                    <p class="font-mono text-sm uppercase tracking-[0.25em] text-amber-300">Same use case · JavaScript</p>
                    <h1 class="mt-5 text-5xl font-black tracking-tight sm:text-6xl">Write JavaScript.<br><span class="text-amber-300">Ship JavaScript.</span></h1>
                    <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">This page keeps the markup and behavior equivalent to the Lua demo so the authoring languages can be compared without changing the use case.</p>
                    <a href="#playground" class="mt-8 inline-block rounded-xl bg-amber-300 px-5 py-3 font-bold text-slate-950 hover:bg-amber-200">Try the counter</a>
                </div>
                <pre class="overflow-x-auto rounded-3xl border border-slate-800 bg-slate-900 p-6 text-sm leading-7 shadow-2xl shadow-amber-950/30" aria-label="JavaScript source example"><code><span class="text-fuchsia-300">let</span> count = <span class="text-amber-300">0</span>;
<span class="text-fuchsia-300">const</span> render = () =&gt; {
  output.textContent = count;
};

button.addEventListener(<span class="text-emerald-300">"click"</span>, () =&gt; {
  count = count + <span class="text-amber-300">1</span>;
  render();
});</code></pre>
            </section>

            <section id="playground" class="mt-20 rounded-3xl border border-slate-800 bg-slate-900/70 p-8 sm:p-10" aria-labelledby="playground-title">
                <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-center">
                    <div><p class="font-mono text-sm text-amber-300">LIVE CLIENT INTERACTION</p><h2 id="playground-title" class="mt-3 text-3xl font-bold">The same counter controlled by JavaScript</h2><p class="mt-3 text-slate-400">This is the baseline for comparing readability and generated output.</p></div>
                    <output id="counter-value" class="min-w-32 text-center font-mono text-7xl font-black text-amber-300" aria-live="polite">0</output>
                </div>
                <div class="mt-8 flex flex-wrap gap-3">
                    <button id="decrement" class="rounded-xl border border-slate-700 px-5 py-3 font-bold hover:bg-slate-800">− Decrease</button>
                    <button id="increment" class="rounded-xl bg-amber-300 px-5 py-3 font-bold text-slate-950 hover:bg-amber-200">+ Increase</button>
                    <button id="reset" class="rounded-xl px-5 py-3 font-bold text-slate-400 hover:text-white">Reset</button>
                </div>
                <p id="counter-status" class="mt-6 text-sm text-slate-400" aria-live="polite">JavaScript is ready.</p>
            </section>
        </main>
    </div>
</body>

<client lang="js">
let count = 0;
const output = document.querySelector("#counter-value");
const status = document.querySelector("#counter-status");
const increment = document.querySelector("#increment");
const decrement = document.querySelector("#decrement");
const reset = document.querySelector("#reset");

const render = () => {
    output.textContent = count;
    status.textContent = "JavaScript rendered count " + count;
};

increment.addEventListener("click", () => {
    count = count + 1;
    render();
});

decrement.addEventListener("click", () => {
    count = count - 1;
    render();
});

reset.addEventListener("click", () => {
    count = 0;
    render();
});
</client>
