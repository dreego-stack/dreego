<head>
    <title>Ledgerboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A small SaaS dashboard demo built with Dreego.">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<go>
    workspace := "Northstar"
</go>

<div>
    <div class="min-h-screen bg-slate-100 text-slate-900">
        <header class="border-b border-slate-200 bg-white">
            <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4" aria-label="Workspace navigation">
                <a href="/" class="flex items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-xl bg-indigo-600 text-sm font-bold text-white">L</span><span class="font-semibold tracking-tight">Ledgerboard</span></a>
                <div class="flex items-center gap-4 text-sm"><span class="hidden text-slate-500 sm:inline">{{ workspace }} workspace</span><button class="rounded-full border border-slate-200 px-3 py-1.5 font-medium hover:bg-slate-50">JD</button></div>
            </nav>
        </header>
        <main class="mx-auto max-w-7xl px-6 py-10">
            <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-medium text-indigo-600">Monday, August 24, 2026</p><h1 class="mt-2 text-3xl font-semibold tracking-tight">Good morning, Jamie.</h1><p class="mt-2 text-slate-500">Here is what is happening in {{ workspace }}.</p></div><button class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Create report</button></div>
            <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Workspace metrics">
                <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Monthly recurring revenue</p><p class="mt-3 text-3xl font-semibold">€42,680</p><p class="mt-2 text-sm text-emerald-600">↑ 8.4% this month</p></article>
                <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Active accounts</p><p class="mt-3 text-3xl font-semibold">1,284</p><p class="mt-2 text-sm text-emerald-600">↑ 4.1% this month</p></article>
                <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Churn rate</p><p class="mt-3 text-3xl font-semibold">1.8%</p><p class="mt-2 text-emerald-600 text-sm">↓ 0.3% this month</p></article>
                <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Open tasks</p><p class="mt-3 text-3xl font-semibold">24</p><p class="mt-2 text-sm text-amber-600">7 due today</p></article>
            </section>
            <section class="mt-8 grid gap-6 lg:grid-cols-[1.35fr_.65fr]">
                <article class="rounded-2xl border border-slate-200 bg-white p-6"><div class="flex items-center justify-between"><div><h2 class="font-semibold">Revenue overview</h2><p class="mt-1 text-sm text-slate-500">Last 30 days</p></div><button class="text-sm font-medium text-indigo-600">View report</button></div><div class="mt-8 flex h-48 items-end gap-2" aria-label="Revenue chart"><div class="h-[38%] flex-1 rounded-t bg-indigo-100"></div><div class="h-[46%] flex-1 rounded-t bg-indigo-200"></div><div class="h-[42%] flex-1 rounded-t bg-indigo-200"></div><div class="h-[58%] flex-1 rounded-t bg-indigo-300"></div><div class="h-[54%] flex-1 rounded-t bg-indigo-300"></div><div class="h-[70%] flex-1 rounded-t bg-indigo-400"></div><div class="h-[64%] flex-1 rounded-t bg-indigo-400"></div><div class="h-[82%] flex-1 rounded-t bg-indigo-500"></div><div class="h-[76%] flex-1 rounded-t bg-indigo-500"></div><div class="h-[94%] flex-1 rounded-t bg-indigo-600"></div></div><div class="mt-3 flex justify-between text-xs text-slate-400"><span>01 Aug</span><span>15 Aug</span><span>30 Aug</span></div></article>
                <article class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="font-semibold">Recent activity</h2><ul class="mt-5 space-y-5 text-sm"><li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-emerald-500"></span><div><p class="font-medium">Acme upgraded</p><p class="mt-1 text-slate-400">12 minutes ago</p></div></li><li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-indigo-500"></span><div><p class="font-medium">Report exported</p><p class="mt-1 text-slate-400">48 minutes ago</p></div></li><li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-amber-500"></span><div><p class="font-medium">Trial ending soon</p><p class="mt-1 text-slate-400">2 hours ago</p></div></li></ul><a href="/activity" class="mt-8 inline-block text-sm font-medium text-indigo-600">See all activity →</a></article>
            </section>
        </main>
    </div>
</div>
