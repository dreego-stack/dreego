<head>
    <title>Dreego Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Notes on building Dreego, the compile-time Go web framework.">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<server>
    type Post struct {
        Title   string
        Slug    string
        Date    string
        Excerpt string
    }
    posts := []Post{
        {Title: "Hello, Dreego", Slug: "hello-dreego", Date: "2026-08-24", Excerpt: "A first look at the v0.2 and v0.3 releases: typed SSR, the render foundation, and Markdown bodies."},
        {Title: "The Render Foundation", Slug: "rendering-foundation", Date: "2026-08-18", Excerpt: "How the v0.2 render foundation keeps generated inputs typed and opens the door to SSG and Wails."},
        {Title: "Markdown in the Body", Slug: "markdown-in-the-body", Date: "2026-08-10", Excerpt: "Write real Markdown in a <body lang=\"md\"> section and mix in Dreego constructs."},
    }
</server>

<body>
    <header class="border-b border-slate-200 bg-[#f7f7f3]">
        <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5" aria-label="Main navigation">
            <a href="/" class="font-mono text-sm font-bold tracking-tight">dreego / blog</a>
            <div class="flex items-center gap-5 text-sm text-slate-600">
                <a href="#posts" class="hover:text-slate-950">Posts</a>
                <a href="https://github.com/dreego-stack/dreego" class="rounded-full bg-slate-950 px-4 py-2 font-medium text-white hover:bg-slate-700">Source</a>
            </div>
        </nav>
    </header>

    <main>
        <section class="mx-auto max-w-4xl px-6 py-20">
            <p class="mb-6 font-mono text-xs uppercase tracking-[0.24em] text-emerald-700">Field notes</p>
            <h1 class="max-w-2xl text-5xl font-semibold leading-[0.98] tracking-[-0.06em] md:text-6xl">Building Dreego, in the open.</h1>
            <p class="mt-8 max-w-xl text-lg leading-8 text-slate-600">Short posts about the framework, its design constraints, and the decisions behind each release.</p>
        </section>

        <section id="posts" class="border-y border-slate-200 bg-white">
            <div class="mx-auto max-w-4xl px-6 py-20">
                <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
                    <div><p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">01 / posts</p><h2 class="mt-3 text-3xl font-semibold tracking-tight">Latest writing.</h2></div>
                    <p class="max-w-sm text-sm leading-6 text-slate-500">Every post is a real Markdown body rendered by the v0.3 md processor.</p>
                </div>
                <div class="grid gap-5 md:grid-cols-2">
                    {#each posts as post}
                        <@PostCard title={post.Title} slug={post.Slug} date={post.Date} excerpt={post.Excerpt}/>
                    {/each}
                </div>
            </div>
        </section>
    </main>

    <footer class="border-t border-slate-200"><div class="mx-auto flex max-w-4xl flex-wrap justify-between gap-4 px-6 py-8 text-sm text-slate-500"><span class="font-mono">dreego / blog</span><span>Written in Markdown.</span></div></footer>
</body>
