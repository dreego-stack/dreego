<head>
    <title>News — Dreego</title>
    <meta name="description" content="Announcements from the Dreego team, rendered from markdown at runtime.">
</head>

<server>
    type NewsForm struct {
        Title   string `form:"title" validate:"required"`
        Content string `form:"content" validate:"required"`
    }

    func CreateNews(c dreego.Context, form NewsForm) error {
        newsPosts = append(newsPosts, NewsPost{Title: form.Title, Date: "2026-09-05", Content: form.Content})
        return c.Redirect("/blog/news", 303)
    }
</server>

<server>
    var newsHTML strings.Builder
    for _, p := range newsPosts {
        html, err := dreego.MarkdownToHTML(p.Content)
        if err != nil {
            return "", err
        }
        newsHTML.WriteString(`<article class="mb-10 rounded-3xl border border-slate-200 bg-white p-7">`)
        newsHTML.WriteString(`<div class="mb-3 flex items-center justify-between">`)
        newsHTML.WriteString(`<span class="font-mono text-xs text-emerald-700">` + p.Date + `</span>`)
        newsHTML.WriteString(`<span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">announcement</span>`)
        newsHTML.WriteString(`</div>`)
        newsHTML.WriteString(`<h2 class="mb-4 text-2xl font-semibold tracking-tight text-slate-900">` + p.Title + `</h2>`)
        newsHTML.WriteString(html)
        newsHTML.WriteString(`</article>`)
    }
</server>

<body lang="html">
    <nav class="mb-10 flex items-center gap-2" aria-label="News navigation">
        <a href="/blog/" class="rounded-full border border-slate-200 px-4 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">← Back to blog</a>
        <span class="rounded-full bg-slate-950 px-4 py-1.5 text-sm font-medium text-white">News</span>
    </nav>

    <p class="mb-6 font-mono text-xs uppercase tracking-[0.24em] text-emerald-700">Announcements</p>
    <h1>News.</h1>
    <p class="mb-14">Runtime-rendered markdown, straight from the store.</p>

    <div class="news-posts">
        {{ newsHTML.String() | raw }}
    </div>

    <div class="mt-16 rounded-3xl border border-slate-200 bg-white p-7">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-slate-900">Publish an announcement</h2>
        <form g-action="CreateNews" method="post" class="space-y-4">
            <input type="hidden" name="csrf_token" value="{{ c.CSRFToken() }}">
            <div>
                <label for="title" class="mb-1 block text-sm font-medium text-slate-700">Title</label>
                <input id="title" name="title" type="text" value="{{ c.Old("title") }}" class="w-full rounded-xl border border-slate-300 px-4 py-2 text-slate-900 focus:border-emerald-600 focus:outline-none">
                {#if c.Errors("title") != ""}
                    <p class="mt-1 text-sm text-red-600">{{ c.Errors("title") }}</p>
                {/if}
            </div>
            <div>
                <label for="content" class="mb-1 block text-sm font-medium text-slate-700">Content (markdown)</label>
                <textarea id="content" name="content" rows="6" class="w-full rounded-xl border border-slate-300 px-4 py-2 font-mono text-sm text-slate-900 focus:border-emerald-600 focus:outline-none">{{ c.Old("content") }}</textarea>
                {#if c.Errors("content") != ""}
                    <p class="mt-1 text-sm text-red-600">{{ c.Errors("content") }}</p>
                {/if}
            </div>
            <button type="submit" class="rounded-full bg-slate-950 px-6 py-2 font-medium text-white hover:bg-slate-700">Publish</button>
        </form>
    </div>
</body>
