Component PostCard (title string, slug string, date string, excerpt string)

<body>
    <a href="/posts/{{ slug }}" class="group block rounded-3xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-slate-400 hover:shadow-lg">
        <div class="flex items-center justify-between">
            <span class="font-mono text-xs text-emerald-700">{{ date }}</span>
            <span class="text-slate-400 transition group-hover:translate-x-1">↗</span>
        </div>
        <h3 class="mt-6 text-2xl font-semibold tracking-tight text-slate-900">{{ title }}</h3>
        <p class="mt-3 max-w-sm leading-7 text-slate-600">{{ excerpt }}</p>
    </a>
</body>
