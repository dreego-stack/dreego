package main

import (
	"log"
	"os"

	dreego "github.com/dreego-stack/dreego/core"
	"§$name$§/dreego/gen"
)

func main() {
	app := dreego.New()
	if err := gen.Register(app); err != nil {
		log.Fatal(err)
	}
	addr := ":8080"
	if p := os.Getenv("DREEGO_PORT"); p != "" {
		addr = ":" + p
	}
	if err := app.Listen(addr); err != nil {
		log.Fatal(err)
	}
}
