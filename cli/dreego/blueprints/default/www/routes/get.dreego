<head>
    <meta name="description" content="§$name$§ — Built with Dreego">
</head>

<server>
    message := "Hello, Dreego!"
</server>

<body>
    <h1>{{ message }}</h1>
    <p>Edit <code>www/routes/get.dreego</code> and reload.</p>
</body>

<style>
    body { font-family: system-ui; max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    h1 { color: #333; }
</style>