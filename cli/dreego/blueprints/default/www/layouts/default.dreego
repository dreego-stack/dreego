<div>
<html lang="en">
<head>
    <title>§$name$§</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {#head}
</head>
<body>
    <a href="#main" class="skip-link">skip to content</a>
    <main id="main">
    {#slot}
    </main>
</body>
</html>
</div>

<style>
.skip-link { position: absolute; left: -9999px; }
.skip-link:focus { position: fixed; top: 0.5rem; left: 0.5rem; z-index: 100; padding: 0.5rem 1rem; background: #000; color: #fff; border-radius: 0.25rem; }
</style>