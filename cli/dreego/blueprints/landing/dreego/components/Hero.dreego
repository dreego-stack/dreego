Component Hero (badge string, title string, subtitle string, cta1 string, cta2 string)

<div>
    <main class="pt-28 pb-20 px-6 max-w-4xl mx-auto text-center relative">
        <div class="absolute inset-0 bg-grid opacity-40 -z-10"></div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-50 text-blue-700 rounded-full text-sm font-semibold mb-8 ring-1 ring-blue-200/60">✨ {{ badge }}</div>
        <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.05] mb-6 max-w-3xl mx-auto">{{ title }}</h1>
        <p class="text-lg md:text-xl text-slate-500 max-w-2xl mx-auto mb-10 leading-relaxed">{{ subtitle }}</p>
        <div class="flex flex-wrap justify-center gap-4 mb-16">
            <a href="/signup" class="px-8 py-3.5 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 transition-colors text-lg shadow-xl shadow-slate-900/20">{{ cta1 }}</a>
            <a href="/docs" class="px-8 py-3.5 bg-white text-slate-700 font-semibold rounded-xl hover:bg-slate-50 border border-slate-200 transition-colors text-lg shadow-sm">{{ cta2 }}</a>
        </div>

        <div class="inline-block bg-slate-900 rounded-2xl p-0.5 shadow-2xl shadow-slate-900/20">
            <div class="bg-slate-950 rounded-2xl px-6 py-5 text-left">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                </div>
                <code class="text-sm text-emerald-400 font-mono leading-relaxed">$ dreego new myapp<br>$ dreego generate &amp;&amp; go run .<br><span class="text-slate-500">→ Server listening on :8080</span></code>
            </div>
        </div>
    </main>
</div>

<style>
.bg-grid { background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px); background-size: 24px 24px; }
</style>
