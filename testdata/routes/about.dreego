<head>
    <meta name="description" content="About page">
</head>

<go>
    name := "Welt"
    items := []string{"Apfel", "Banane", "Kirsche"}
    showDetails := true
</go>

<div>
    <h1>Hallo {name}!</h1>
    {#if showDetails}
        <p>Willkommen auf der About-Seite.</p>
    {/if}
    <p>Meine Fruchte:</p>
    <ul>
        {#each items as item}
            <li>{item}</li>
        {/each}
    </ul>
    <a href="/">Home</a>
</div>

<script>
    console.log("about page loaded");
</script>

<style>
    h1 { color: blue; }
</style>
