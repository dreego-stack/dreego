                    <ul class="space-y-3 text-sm text-slate-600 mb-8 flex-1">
                        <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">&check;</span> Unlimited routes</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">&check;</span> Community support</li>
                        <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">&check;</span> MIT License</li>
                    </ul>
                    <a href="/signup" class="block text-center py-3 font-semibold rounded-xl ring-1 ring-slate-200 hover:bg-slate-50 transition-colors text-slate-700">Get started</a>
                </div>

                <div class="bg-slate-900 rounded-2xl p-8 ring-1 ring-slate-900 flex flex-col relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full">POPULAR</div>
                    <h3 class="text-lg font-bold text-white">Pro</h3>
                    <p class="text-sm text-slate-400 mt-1 mb-4">For professional developers.</p>
                    <div class="mb-6"><span class="text-4xl font-extrabold text-white">$29</span><span class="text-slate-400">/mo</span></div>
                    <ul class="space-y-3 text-sm text-slate-300 mb-8 flex-1">
                        <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">&check;</span> Everything in Free</li>
