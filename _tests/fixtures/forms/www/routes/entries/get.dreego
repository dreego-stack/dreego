<head>
    <title>Entries</title>
</head>

<server>
    empty := len(entries) == 0
</server>

<body>
    <h1>
        Entries</h1>
    {#if empty}
        <p>
            No entries yet</p>
    {#else}
        <ul>
        {#each entries as entry}
            <li>
                {{ entry }}</li>
        {/each}
        </ul>
    {/if}
    <p>
        <a href="/">
            Post a message</a>
    </p>
</body>
