<head>
    <title>Counter</title>
</head>

<server>
    count := c.SessionVal("count")
</server>

<body>
    <h1>
        Counter</h1>
    <p>
        Count: {{ len(count) }}</p>
    <form method="post">
        <input type="hidden" name="csrf_token" value="{{ c.CSRFToken() }}">
        <button type="submit">
            Increment</button>
    </form>
</body>

<server method="post">
    n := c.SessionVal("count")
    c.SetSessionVal("count", n+"x")
</server>
<body method="post">
    <p>
        incremented</p>
</body>
