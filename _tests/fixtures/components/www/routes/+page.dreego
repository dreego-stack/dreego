GOIMPORT { catalog "components/catalog" }

<head>
    <title>Shop</title>
</head>

<server>
    products := catalog.Products()
</server>

<body>
    <@PageShell title="Welcome to the shop">
        <div class="grid">
        {#each products as product}
            <@ProductCard name={product.Name} price={product.Price} inStock={product.InStock}/>
        {/each}
        </div>
    </@PageShell>
</body>
