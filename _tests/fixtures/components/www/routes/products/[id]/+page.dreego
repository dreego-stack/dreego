GOIMPORT { catalog "components/catalog" }

<head>
    <title>Product</title>
</head>

<server>
    products := catalog.Products()
    id := c.Param("id")
    var product catalog.Product
    if id == "1" {
        product = products[0]
    } else {
        product = products[1]
    }
</server>

<body>
    <@PageShell title="Product detail">
        <@ProductCard name={product.Name} price={product.Price} inStock={product.InStock}/>
        <p>
            <a href="/">
                Back to shop</a>
        </p>
    </@PageShell>
</body>
