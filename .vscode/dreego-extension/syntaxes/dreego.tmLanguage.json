{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dreego",
  "scopeName": "text.html.dreego",
  "fileTypes": [".dreego"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#template-expressions" },
    { "include": "#section-head" },
    { "include": "#section-go" },
    { "include": "#section-div" },
    { "include": "#section-script" },
    { "include": "#section-style" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.dreego",
          "begin": "\\{!",
          "end": "!\\}"
        }
      ]
    },
    "template-expressions": {
      "patterns": [
        {
          "name": "keyword.control.conditional.dreego",
          "match": "\\{#if\\b|\\{#else\\b|\\{/if\\}|\\{#each\\b|\\{/each\\}|\\{#slot\\}|\\{#head\\}|\\{#verbatim\\b|\\{/verbatim\\}"
        },
        {
          "name": "string.template.dreego",
          "begin": "\\{(?![#!/])",
          "end": "\\}",
          "patterns": [
            {
              "name": "variable.other.dreego",
              "match": "[a-zA-Z_][a-zA-Z0-9_.()|]*"
            }
          ]
        }
      ]
    },
    "section-head": {
      "name": "meta.section.head.dreego",
      "begin": "<head>",
      "end": "</head>",
      "beginCaptures": { "0": { "name": "entity.name.tag.head.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.head.dreego" } },
      "patterns": [
        { "include": "text.html.basic" }
      ]
    },
    "section-go": {
      "name": "meta.section.go.dreego",
      "begin": "<go>",
      "end": "</go>",
      "beginCaptures": { "0": { "name": "entity.name.tag.go.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.go.dreego" } },
      "patterns": [
        { "include": "source.go" }
      ]
    },
    "section-div": {
      "name": "meta.section.div.dreego",
      "begin": "<div>",
      "end": "</div>",
      "beginCaptures": { "0": { "name": "entity.name.tag.div.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.div.dreego" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#template-expressions" },
        { "include": "text.html.basic" }
      ]
    },
    "section-script": {
      "name": "meta.section.script.dreego",
      "begin": "<script>",
      "end": "</script>",
      "beginCaptures": { "0": { "name": "entity.name.tag.script.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.script.dreego" } },
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "section-style": {
      "name": "meta.section.style.dreego",
      "begin": "<style>",
      "end": "</style>",
      "beginCaptures": { "0": { "name": "entity.name.tag.style.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.style.dreego" } },
      "patterns": [
        { "include": "source.css" }
      ]
    }
  }
}
