{
  "name": "dreego",
  "displayName": "Dreego Syntax Highlighting",
  "description": "Syntax highlighting for Dreego (.dreego) files",
  "version": "0.0.4",
  "icon": "dreego.svg",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "dreego",
      "aliases": ["Dreego", "dreego"],
      "extensions": [".dreego"],
      "icon": {
        "light": "./dreego.svg",
        "dark": "./dreego.svg"
      },
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "dreego",
      "scopeName": "text.html.dreego",
      "path": "./syntaxes/dreego.tmLanguage.json"
    }]
  }
}
