{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<", ">"],
    ["{", "}"],
    ["(", ")"],
    ["{!", "!}"],
    ["{#", "}"]
  ],
  "autoClosingPairs": [
    ["<", ">"],
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""],
    ["{!", "!}"],
    ["{#", "}"]
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "<(?!area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr|!|@)[^>]*[^/]>(?!.*</)",
    "decreaseIndentPattern": "^\\s*</"
  }
}
