{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dreego",
  "scopeName": "text.html.dreego",
  "fileTypes": [".dreego"],
  "patterns": [
    { "include": "#component-header" },
    { "include": "#imports" },
    { "include": "#comments" },
    { "include": "#template-expressions" },
    { "include": "#component-tags" },
    { "include": "#section-head" },
    { "include": "#section-go" },
    { "include": "#section-div" },
    { "include": "#section-script" },
    { "include": "#section-style" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "component-header": {
      "patterns": [
        {
          "name": "meta.component.dreego",
          "match": "^Component\\s+(\\w+)\\s*(\\([^)]*\\))?",
          "captures": {
            "1": { "name": "entity.name.type.class.dreego" },
            "2": { "name": "variable.parameter.dreego" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.dreego",
          "match": "^import\\s+(\\w+\\s+)?\"([^\"]+)\"",
          "captures": {
            "1": { "name": "entity.name.type.alias.dreego" },
            "2": { "name": "string.quoted.double.dreego" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.dreego",
          "begin": "\\{!",
          "end": "!\\}"
        }
      ]
    },
    "template-expressions": {
      "patterns": [
        {
          "name": "keyword.control.conditional.dreego",
          "match": "\\{#if\\b|\\{#else\\b|\\{/if\\}|\\{#each\\b|\\{#each else\\}|\\{/each\\}|\\{#slot[^}]*\\}|\\{/slot\\}|\\{#head\\}|\\{#verbatim\\b|\\{/verbatim\\}"
        },
        {
          "name": "string.template.dreego",
          "begin": "\\{(?![#!/])",
          "end": "\\}",
          "patterns": [
            {
              "name": "support.function.filter.dreego",
              "match": "\\|\\s*(raw|upper)"
            },
            {
              "name": "variable.language.loop.dreego",
              "match": "\\$loop"
            },
            {
              "name": "variable.other.dreego",
              "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
            }
          ]
        }
      ]
    },
    "component-tags": {
      "patterns": [
        {
          "name": "meta.tag.component.open.dreego",
          "begin": "<@(\\w+)",
          "end": ">",
          "beginCaptures": {
            "1": { "name": "entity.name.tag.component.dreego" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.dreego",
              "match": "\\w+(?=\\s*[=])"
            },
            {
              "name": "string.quoted.double.dreego",
              "match": "\"[^\"]*\""
            },
            {
              "name": "variable.other.dreego",
              "match": "\\{[^}]*\\}"
            }
          ]
        },
        {
          "name": "meta.tag.component.close.dreego",
          "match": "</@(\\w+)>",
          "captures": {
            "1": { "name": "entity.name.tag.component.dreego" }
          }
        }
      ]
    },
    "section-head": {
      "name": "meta.section.head.dreego",
      "begin": "<head>",
      "end": "</head>",
      "beginCaptures": { "0": { "name": "entity.name.tag.head.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.head.dreego" } },
      "patterns": [
        { "include": "text.html.basic" }
      ]
    },
    "section-go": {
      "name": "meta.section.go.dreego",
      "begin": "<go>",
      "end": "</go>",
      "beginCaptures": { "0": { "name": "entity.name.tag.go.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.go.dreego" } },
      "patterns": [
        { "include": "source.go" }
      ]
    },
    "section-div": {
      "name": "meta.section.div.dreego",
      "begin": "<div>",
      "end": "</div>",
      "beginCaptures": { "0": { "name": "entity.name.tag.div.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.div.dreego" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#template-expressions" },
        { "include": "#component-tags" },
        { "include": "text.html.basic" }
      ]
    },
    "section-script": {
      "name": "meta.section.script.dreego",
      "begin": "<script>",
      "end": "</script>",
      "beginCaptures": { "0": { "name": "entity.name.tag.script.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.script.dreego" } },
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "section-style": {
      "name": "meta.section.style.dreego",
      "begin": "<style>",
      "end": "</style>",
      "beginCaptures": { "0": { "name": "entity.name.tag.style.dreego" } },
      "endCaptures": { "0": { "name": "entity.name.tag.style.dreego" } },
      "patterns": [
        { "include": "source.css" }
      ]
    }
  }
}
