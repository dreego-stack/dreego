func Badge(title string, tone string) dreego.Component {
	return dreego.ComponentFunc(func(ctx *dreego.SSRContext) (string, error) {
		var b strings.Builder

		b.WriteString("<div data-scope=\"89b1dd407f26\">")
		b.WriteString(`
    `)
		b.WriteString(`<span>`)
		b.WriteString(dreego.SafeText(fmt.Sprintf("%v", title)))
		b.WriteString(`</span>`)
		b.WriteString(`
    `)
		b.WriteString(`<em>`)
		b.WriteString(dreego.SafeText(fmt.Sprintf("%v", tone)))
		b.WriteString(`</em>`)
		b.WriteString(`
`)
		b.WriteString("</div>")
		b.WriteString("<style>")
		b.WriteString(`[data-scope=89b1dd407f26] .badge{ font-weight: bold; }[data-scope=89b1dd407f26] .badge em{ color: #666; }`)
		b.WriteString("</style>")

		return b.String(), nil
	})
}

